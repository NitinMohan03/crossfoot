# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=

# Postgres (docker compose reads these; defaults match compose.yaml)
POSTGRES_USER=crossfoot
POSTGRES_PASSWORD=crossfoot
POSTGRES_DB=crossfoot
# 5433: a native Windows postgres service commonly holds 5432 (see compose.yaml).
POSTGRES_PORT=5433
DATABASE_URL=postgresql://crossfoot:crossfoot@localhost:5433/crossfoot

# Mock payment processor API (`just proc-api`). Defaults in mock_processor/settings.py.
CROSSFOOT_PROCESSOR_DATA=data/full
CROSSFOOT_PROCESSOR_TOKEN=dev-processor-token
CROSSFOOT_PROCESSOR_RATE=20
CROSSFOOT_PROCESSOR_BURST=40
